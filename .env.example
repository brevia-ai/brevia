# Copy to .env. Uncomment optional settings as needed; never commit credentials.
# Full reference: docs/guides/configuration.md

# Local database from compose.yaml.
BREVIA_DATABASE_URL=postgresql://brevia:brevia@localhost:5435/brevia

# Model provider: set only the one you use.
# Load keys with: uv run --env-file .env python your_script.py
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Files: shared storage for workers and readers; only listed HTTPS hosts allowed.
# BREVIA_FILES_ROOT=/var/lib/brevia/files
# BREVIA_FILES_ALLOWED_HOSTS=documents.example.org
# BREVIA_FILES_RETENTION_DAYS=30  # 0 keeps outputs indefinitely

# Authentication: set a secret when using token authentication (32+ bytes).
# BREVIA_TOKENS_SECRET=
# BREVIA_ACCESS_ADMINS=backend
# BREVIA_AUTH_DISABLED=false  # true only for local, anonymous access

# Development options.
# BREVIA_PROJECT_FILE=brevia.toml
# BREVIA_LOG_LEVEL=INFO
# BREVIA_FAKE_MODELS=false  # true avoids real model calls
# BREVIA_TEST_DATABASE_URL=postgresql://brevia:brevia@localhost:5435/brevia

# Advanced settings: docs/guides/database.md and docs/guides/workers.md
