# Copy to .env (never committed) and fill in.
# The port of compose.yaml: 5432, or DB_PORT when set to start the database on another one
BREVIA_DATABASE_URL=postgresql://brevia:brevia@localhost:5432/brevia
# Secret of the tokens of the HTTP API, at least 32 bytes; then
#   uv run --env-file .env brevia token create --user my-frontend
BREVIA_TOKENS_SECRET=
# Provider key, read by the provider from the process environment (uv run --env-file .env)
OPENAI_API_KEY=
# Files of runs, needed to pass input files by URL (document.summarize with "file")
# BREVIA_FILES_ROOT=./files
# BREVIA_FILES_ALLOWED_HOSTS=docs.example.org
# Answer every model call with a fake: local runs and tests, never in production
# BREVIA_FAKE_MODELS=true
