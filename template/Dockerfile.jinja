# Image of the application: the job worker and the HTTP API, started by bin/start.
#   docker build -t {{ project_slug }} .
# Keep the version of uv below as the one used to write uv.lock: an older uv may not
# read a newer lockfile. The image runs as root, so it can write to the volumes that
# platforms mount as root; no secret is copied into it.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends tini{% if brevia_source.startswith("git+") %} git{% endif %} \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_CACHE=1 \
    UV_PYTHON_DOWNLOADS=never \
    PATH="/app/.venv/bin:$PATH" \
    PORT=8000
WORKDIR /app

# Dependencies first, in a layer of their own that later builds reuse.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY . .
RUN uv sync --locked --no-dev && chmod +x bin/start

EXPOSE 8000
ENTRYPOINT ["tini", "--", "bin/start"]
