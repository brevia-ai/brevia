[project]
name = {{ project_slug | tojson }}
version = "0.1.0"
description = {{ description | tojson }}
{% if author_name %}authors = [{ name = {{ author_name | tojson }}{% if author_email %}, email = {{ author_email | tojson }}{% endif %} }]
{% endif %}requires-python = ">=3.12"
dependencies = [
    {{ ("brevia @ " ~ brevia_source) | tojson }},
]

[dependency-groups]
dev = [
    "pytest>=9.1",
    "pytest-asyncio>=1.2",
    "ruff>=0.17",
]

[build-system]
requires = ["hatchling>=1.27"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.hatch.metadata]
allow-direct-references = true

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
select = ["E", "W", "F", "I", "UP", "B", "SIM", "RUF"]

[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
asyncio_default_fixture_loop_scope = "function"
